+    // padlocks
+    const lock = (y, hid) => {
+      const b = abs("ldlock", `left:77px;top:${y + 2}px;width:13px;height:15px;cursor:pointer;display:flex;align-items:center;justify-content:center`, SVG_LOCK(true));
