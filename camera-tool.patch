+
+/* number fields: flat grey boxes, value left aligned */
+#panels .camopts input[type=text], #panels .camopts input[type=number] {
+  box-sizing: border-box; height: 17px; padding: 0 4px; margin: 0 0 0 5px; border: 0; border-radius: 3px;
