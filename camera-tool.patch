+  color: transparent; font-size: 0 !important; padding: 0 !important; height: 17px; cursor: pointer;
+  background-repeat: no-repeat; background-position: center; flex: none;
+}
+#panels .camopts .revbtn:hover { background-color: #55545c; }
+#panels .camopts #camToggle {
+  width: 20px; margin-left: 8px; background-color: #3c3b41;
+}
+#panels .camopts #camParams {
+  width: 88px; margin: 3px 0 0 114px; color: #c3c2c8 !important; font-size: 12px !important; font-family: inherit;
+  background-image: none !important;
+}
+#panels .camopts #camToggle, #panels .camopts .camwr {
