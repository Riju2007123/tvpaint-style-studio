+/* camera.css - the Camera[Pro] tool panel of TVPaint 12 (measured on the live
+   application at 1920x1080, row pitch 19 px, panel text 12 px). */
+
+/* ---- panel header: a dot, a round chevron disc and a round close disc ---- */
+#panels .phead .pw {
+  width: 13px; height: 13px; padding: 0; margin-left: 5px; border: 0; border-radius: 50%;
+  background: #7f7e84; color: #302f34; font-size: 8px; line-height: 13px; text-align: center;
+  cursor: pointer; flex: none;
+}
+#panels .phead .pw[title="panel options"] {
+  width: 4px; height: 4px; background: #7f7e84; font-size: 0; margin-right: 4px; margin-left: 4px;
+}
+#panels .phead .pw:hover { background: #a3a2a8; }
+#panels .phead .pt { color: #8e8d93; font-size: 12px; }
+
+/* ---- the option rows of the camera tool ---- */
+#panels .camopts, #panels .camopts.pbody { padding: 0 !important; }
+#panels .camopts .orow {
+  display: flex; align-items: center; position: relative;
+  height: 19px; min-height: 19px; margin: 0 !important; gap: 0 !important; padding: 0;
+  font-size: 12px; color: #a9a8ae;
+}
+#panels .camopts .orow > label {
+  flex: 0 0 85px !important; width: 85px; padding: 0; text-align: right; white-space: nowrap;
+  color: #a9a8ae; font-size: 12px; line-height: 19px; overflow: visible;
