+  border: solid #d0d0d6; border-width: 0 2px 2px 0; transform: rotate(40deg);
+}
+#panels .camopts input[type=checkbox]:disabled { opacity: .5; }
+
+/* small square buttons: wrench / lock / Parameters */
+#panels .camopts .revbtn {
