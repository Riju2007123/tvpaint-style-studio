33_cmd0=EmbeddedGrg:#param none\x\xtv_getpath "home" //path par defaut\xsrcFolder=result \x\xtv_readuserstring "ExportDigital" "folder" srcFolder\xsrcFolder=result\x\x//Ouverture du file requester\xrequester = FileRequester("<Select a folder to save in...",srcFolder,srcFile,"*.txt")\xIF ( requester!=1 )\x	EXIT\xEND\x\xtv_SaveMode "PNG" "b32"\x\xtv_layercurrentid\xInitLayer = result\x\xtv_layergetimage\xInitImage = result\x\xtv_firstimage\xCurrentImage = result\x\xtv_lastimage\xLastImage = result\x\xtv_clipcurrentid\xClipID = result\x\xtv_clipname ClipID\xClipName = result\x\xlayerRun = 1\xlayerCount = 0\xWHILE ( layerRun == 1 )\x    tv_LayerGetID layerCount\x    layerID = result\x    IF ( CMP( layerID, "NONE" ) != 0 )\x        layerRun = 0\x    ELSE    \x        layerCount = layerCount + 1\x    END\xEND\x\xWHILE ( CurrentImage <= LastImage )\x\x    layerRun = 1\x    layerPos = 0\x\x    WHILE ( layerRun == 1 )   \x        tv_LayerGetID layerPos\x        layerID = result\x        IF ( CMP( layerID, "NONE" ) == 0 )\x            v1 = layerPos+1+layerCount*CurrentImage\x            v2 = layerCount*(LastImage+1)\x            tv_lockdisplay "Exporting all images... ( "v1"/"v2" )"\x\x            tv_LayerSet layerID\x            tv_LayerInfo\x            PARSE result layerDisplay a2 a3 layerName a5 imagePos imageEnd a7 a8 a9 dummy\x\x            IF ( CMP( layerDisplay, "OFF" ) == 0 )\x\x                numlayer = layerPos+1\x                foldername = pathname\x\x                IF ( numlayer < 10 )\x                    foldername = foldername"0"numlayer"_"layerName    \x                ELSE\x                    foldername = foldername""numlayer"_"layerName\x                END \x\x                tv_WriteTextFile "Exists" '"'foldername'"'\x                exist = result\x           \x                IF ( CMP( exist, "0" ) != 0 ) //Si le dossier n'existe pas\x                    tv_WriteTextFile "MkDir" '"'foldername'"'\x                END\x\x                tv_layerImage CurrentImage\x\x                finalPath = foldername"/"ClipName"_"layerName\x\x                IF ( CurrentImage < 10 )\x                    finalPath = finalpath"_00"CurrentImage\x                ELSE\x                    IF ( CurrentImage < 100 )\x                        finalPath = finalpath"_0"CurrentImage\x                    ELSE\x                        finalPath = finalpath"_"CurrentImage\x                    END\x                END\x                tv_saveimage finalPath\x            END\x        ELSE\x            layerRun = 0\x        END\x        layerPos = layerPos + 1\x    END\x\x    CurrentImage = CurrentImage + 1\xEND\x\xtv_layerSet InitLayer\xtv_layerImage InitImage\x\x//------------------------------------------\x//\x//	FileRequester\x//\x//	Function: open a file requester\x//\x//	Call: FileRequester(title,path,file,pattern)\x//\x//	Arguments:\x//		title   = requester title\x//		path    = default directory\x//      file    = default filename\x//      pattern = default pattern\x//\x//	Return: 0 if user clicks on Cancel\x//          1 if user chooses a file. This\x//          function creates three global\x//          variables: fullpath ( path+name+\x//			extension ), pathname (path\x//          to choosen file), filename\x//          (name of choosen file without\x//          extension) and extension\x//          (extension of choosen file)\x//\x//------------------------------------------\x\xFUNCTION FileRequester(title,path,file,pattern)\x	LOCAL point slash size titre\x	\x    fullname = ""\x	fullpath = ""\x	pathname = ""\x	filename = ""\x	extension = ""\x	\x	IF (CMP(pattern,0) == 1)\x		titre = "|"\x	ELSE\x		titre = "|"pattern\x        extension = CUT( pattern, 2, LEN( pattern ) )\x	END\x	IF (CMP(file,0) == 1)\x		titre = "|"titre\x	ELSE\x		titre = "|"file""titre\x	END\x	IF (CMP(path,0) == 1)\x		titre = "|"titre\x	ELSE\x		titre = "|"path""titre\x	END\x	IF (CMP(title,0) == 1)\x		titre = "Choose a file"titre\x	ELSE\x		titre = title""titre\x	END\x\x	tv_ReqFile titre\x	fullname = Result\x	size = LEN(fullname)\x	\x	fullname = Replace(fullname,"\","/")\x\x	IF (CMP(fullname,"Cancel") == 1)\x    	RETURN 0\x    END\x    \x    fullpath = CUT( fullname, LEN(fullname) - LEN( extension ) + 1, LEN(fullname) )\x    IF ( CMP( fullpath, extension ) == 1 )\x        fullpath = fullname\x        fullname = CUT( fullname, 1, LEN(fullname) - LEN( extension ) )\x    ELSE\x        fullpath = fullname""extension\x    END\x\x    start = 1\x    stop = 1\x    WHILE ( start > 0 )\x        start = Find( fullname, "/", stop )\x        IF ( start > 0 )\x            stop = start +1\x        END\x    END\x\x    pathname = CUT( fullpath, 1, stop - 1 )\x    filename = CUT( fullname, stop + 1, LEN( fullname ) )\x\x    RETURN 1\xEND\x\x//------------------------------------------\x//\x//	Replace\x//\x//	Function: replace each occurence of a\x//            substring into a string with\x//            another string\x//\x//	Call: Replace(string,search,repl)\x//\x//	Arguments:\x//		string  = characters string\x//		search  = substring to look for\x//		repl    = replacement substring\x//\x//	Return: result string after replacement\x//\x//------------------------------------------\x\xFUNCTION Replace(string,search,repl)\x	LOCAL pos workstr str1 str2 size\x	pos = 1\x	workstr = string\x	size = LEN(search)\x	\x	WHILE ((pos = FindString(workstr,search,pos)) > 0)\x		IF (pos == 1)\x			str1 = CUT(workstr,size+1,LEN(workstr))\x			workstr = repl""str1\x			pos = 0\x		ELSE\x			str1 = CUT(workstr,1,pos-1)\x			IF ((pos+size) < LEN(workstr))\x				str2 = CUT(workstr,pos+size,LEN(workstr))\x				workstr = str1""repl""str2\x			ELSE\x				workstr = str1""repl\x			END\x		END\x		pos = pos+LEN(repl)\x	END\x	RETURN workstr\xEND\x\x//------------------------------------------\x//\x//	FindString\x//\x//	Function: find a substring into a string\x//             from a specified start position\x//\x//	Call: FindString(string,search,start)\x//\x//	Arguments:\x//		string = characters string\x//		search = substring to look for\x//		start  = start position in string\x//\x//	Return: start position of substring\x//			0 if substring does not exist\x//			into string\x//			-1 if invalid start position\x//			(negative, null or higher\x//			than string length) or if\x//          substring is empty\x//\x//------------------------------------------\x\xFUNCTION FindString(string,search,start)\x	LOCAL found j pos lastpos lstr lsrch\x	found = 0\x	lastpos = start\x	lstr = LEN(string)\x	lsrch = LEN(search)\x	\x	IF (CMP(search,"") == 1)\x		RETURN -1\x	END\x	WHILE ((pos = Find(string,CHAR(search,1),lastpos)) > 0)\x		j = 1\x		found = 1\x		IF (j == lsrch)\x			RETURN pos\x		END\x		WHILE ((j < lsrch) && (found == 1))\x			IF ((pos+j) > lstr)\x				RETURN 0\x			ELSE\x				IF (CMP(CHAR(search,j+1),CHAR(string,pos+j)) == 0)\x					lastpos = pos+j\x					found = 0\x				END\x			END\x			j = j+1\x		END\x		IF (found == 1)\x			RETURN pos\x		END\x	END\x	RETURN pos\xEND\x\x//------------------------------------------\x//\x//	Find\x//\x//	Function: find a character into a string\x//            from a specified start position\x//\x//	Call: Find(string,car,start)\x//\x//	Arguments:\x//		string = characters string\x//		car    = character to look for\x//		start  = start position in string\x//\x//	Return: position of character\x//			0 if character does not exist\x//			into string\x//			-1 if invalid position\x//			(negative, null or higher\x//			 than string length)\x//\x//------------------------------------------\x\xFUNCTION Find(string,car,start)\x	LOCAL i size\x	i = start\x	size = LEN(string)\x	\x	IF ((start <= 0) || (start > size) || (CMP(car,"") == 1))\x		RETURN -1\x	END\x	DO\x		IF (CMP(CHAR(string,i),car) == 1)\x			RETURN i\x		END\x	UNTIL ((i=i+1) > size)\x	RETURN 0\xEND\x
