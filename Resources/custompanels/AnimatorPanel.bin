32_cmd0=EmbeddedGrg:#param none\x\xtv_projectcurrentid\xSourceProjectID = result\x\xclipRun = 1\xclipNum = 0\xWHILE ( clipRun )\x    tv_clipenumid -1 clipNum\x    ClipID = result\x    IF ( CMP( ClipID, "none" ) != 0 )\x 		clipRun = 0\x    ELSE\x        clipNum = clipNum + 1\x    END\xEND\x\xIF ( clipNum <= 1 )\x    tv_warn "There is only one clip. This option requires at least 2 clips."\x    EXIT\xEND\x\xclipRun = 1\xclipNum = 0\xWHILE ( clipRun )\x    tv_projectSelect SourceProjectID  \x    tv_clipenumid -1 clipNum\x    ClipID = result\x\x    IF ( CMP( ClipID, "none" ) != 0 )\x 		clipRun = 0\x    ELSE\x    \x        tv_projectduplicate\x        tv_projectname\x        \x        tv_clipenumid -1 clipNum\x        ClipID = result \x\x        IF ( CMP( ClipID, "none" ) != 0 )\x     		clipRun = 0\x        ELSE\x\x            newclipRun = 1\x            newclipNum = 0\x            WHILE ( newclipRun )\x                tv_clipenumid -1 newclipNum\x                NewClipID = result \x\x                IF ( CMP( NewClipID, "none" ) != 0 )\x             		newclipRun = 0\x                ELSE\x                    IF ( NewClipID != ClipID )\x                        tv_clipclose NewClipID\x                    ELSE\x                        newclipNum = newclipNum + 1\x                    END\x                END\x            END\x            clipNum = clipNum + 1\x        END\x    END\xEND\x
