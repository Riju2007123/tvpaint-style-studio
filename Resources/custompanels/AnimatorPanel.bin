29_cmd0=EmbeddedGrg:tv_reqnum 1 0 10000 "Number of Exposure"\xexp = result\xIF ( CMP( exp, "cancel") == 1 )\x    exit\xEND\x\xtv_layergetimage\ximage = result\x\xtv_layerselectinfo\xParse result selection_start selection_count\xselection_stop = selection_start + selection_count - 1\x\xIF ( selection_count == 0 )\x    tv_exposureset image exp\xELSE\x    tv_undoopenstack\x    FOR i = selection_stop TO selection_start STEP -1\x        tv_exposureinfo i\x        Parse result type tmp\x        IF ( CMP( type, "head") == 1 )\x            tv_exposureset i exp\x        END\x    END\x    tv_undoclosestack\xEND\x
