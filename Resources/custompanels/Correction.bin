4_cmd0=EmbeddedGrg://get the path of the current project\xtv_ProjectInfo\xParse result pathfile tmp\x\x//check if there is an imported project\xif len( pathfile ) <= 1 \x    tv_warn "No imported project"\x    exit\xend\x\x//try to find the extension of the imported project\x//and store the index of the character before the '.'\xhas_extension = 0\xindex = 1\xfor i=len(pathfile) to 1 step -1\x    t = CHAR(pathfile, i)\x    if ( cmp( t, "." ) != 0 )\x        has_extension = 1\x        index = i-1\x        i = 0\x    end\x    if ( cmp( t, "/" ) != 0 || cmp( t, "\" ) != 0 )\x        has_extension = 0\x        index = i+1\x        i = 0\x    end\xend\x\x//check if there is a name before the extension\xt = CHAR( pathfile, index )\xif ( cmp( t, '/' ) != 0 || cmp( t, "\" ) != 0 )\x    tv_warn "File without name before its extension !!!"\x    exit\xend\x\x//remove the extension if there is one\xif has_extension == 1 \x    pathfile = cut( pathfile, 1, index )\xend\x\x//additional suffixe of the exported file\xnote = " (noted)"\x//final name of the exported file\xpathfile = pathfile""note\x\x////////////////////////////////////////////////////////////////////////////////\x\ximage = 1\xfor i=0 to 10000\x    tv_LayerGetID i\x    id = result\x\x    if cmp( id, "none" ) != 0\x        i = 10001\x    else\x        tv_LayerInfo id\x        Parse result display position opacity name type lstart lend more\x\x        count = lend - lstart + 1\x        if ( count > 1 )\x            image = 0\x            i = 10001\x        end\x    end\xend\x\x//set the parameters of the export\xif ( image == 1 )\x    tv_savemode jpg 80\xelse\x    tv_savemode avi mjpg 50\xend\x\x////////////////////////////////////////////////////////////////////////////////\x\x//display the exported file path and export the project to this file\xtv_warn "Export to: "pathfile\xtv_SaveSequence '"'pathfile'"'\x\x\x
